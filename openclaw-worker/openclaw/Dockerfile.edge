# oc551-edge: the worker's only egress (CONNECT allowlist) and its only tool route (POST /mcp to the host core).
FROM node:26.10.0-bookworm-slim@sha256:3ffc19ea878019d9e9ae8971732ad4a03cda44f167107173174b60ed7c65bed3
COPY edge.mjs /opt/edge/edge.mjs
# The tmpfs mount point exists in the image, so the runtime never writes into the read-only root (551 RC1)
RUN mkdir -p /run/secrets
USER node
EXPOSE 3128 8560
CMD ["node", "/opt/edge/edge.mjs"]
