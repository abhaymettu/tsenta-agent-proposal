# oc551-worker: pinned OpenClaw on the pinned base (551 contract s3, s9). Built with --ignore-scripts; no key, no
# secret and no config literal with a secret in any layer. The key arrives at run time as /run/secrets/model_key.
FROM node:26.10.0-bookworm-slim@sha256:3ffc19ea878019d9e9ae8971732ad4a03cda44f167107173174b60ed7c65bed3
ENV OPENCLAW_NO_AUTO_UPDATE=1 DO_NOT_TRACK=1 NPM_CONFIG_UPDATE_NOTIFIER=false NPM_CONFIG_FUND=false
WORKDIR /opt/openclaw
# The verified tarball plus the committed lockfile (551 review F5): npm ci installs exactly the audited tree, no scripts.
COPY openclaw-2026.10.3.tgz worker-package.json worker-package-lock.json ./
RUN echo "761685d010d96645d1deabe19299ecde263eac3f2489a17322f48c461a1130a5  openclaw-2026.10.3.tgz" | sha256sum -c - \
 && mv worker-package.json package.json && mv worker-package-lock.json package-lock.json \
 && npm ci --ignore-scripts --no-audit --omit=dev \
 && rm openclaw-2026.10.3.tgz \
 && ln -s /opt/openclaw/node_modules/.bin/openclaw /usr/local/bin/openclaw
# The package completes its own lifecycle once, as root, with no network (551 supported route; see the script).
COPY lifecycle-complete.sh /opt/demo/lifecycle-complete.sh
RUN --network=none sh /opt/demo/lifecycle-complete.sh
COPY license-scan.mjs /opt/demo/license-scan.mjs
COPY openclaw.json5 /opt/demo/openclaw.json5
COPY entrypoint.sh agent-turn.sh /opt/demo/
# Every tmpfs mount point exists in the image, so the runtime never writes into the read-only root (docker diff stays empty)
RUN chmod 0555 /opt/demo/*.sh && mkdir -p /demo/state /demo/io /run/secrets && chown node:node /demo/state
ENV OPENCLAW_STATE_DIR=/demo/state OPENCLAW_CONFIG_PATH=/demo/state/openclaw.json5
USER node
ENTRYPOINT ["/opt/demo/entrypoint.sh"]
